# NKU Computer Architecture — ignore generated junk for lab1+ (Vivado / XeLaTeX / Python).
# Keep RTL (.v/.h), Vivado sources (.xpr/.xci/.coe/.mif), reports (.tex/.pdf, fig/*.png),
# report/logs, golden_trace.txt, prompt.md, TODO.md.
# Ignore IP regeneration output, project sim trees, and batch logs.

# Existing: local/course materials not for git
resource/

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editor ---
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/

# --- LaTeX (XeLaTeX / latexmk). Keep report.tex, report.pdf, fig/*.png ---
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.xdv
*.bbl
*.blg
*.bcf
*.lof
*.lot
*.nav
*.snm
# XeLaTeX transcript next to the report, not a blanket *.log
**/report/**/*.log

# --- Secrets ---
.env
.env.*
!.env.example

# --- Vivado / Xilinx (any labN/.../*.xpr tree) ---
# Journals (including xsim_*.backup.jou)
*.jou
# Project-dir logs (do not use a global *.log — that would hit report/fig notes)
vivado.log
vivado_*.log
webtalk*.log
xvlog.log
xelab.log
xvhdl.log
elaborate.log
elaborate_dbg.log
compile.log
simulate.log
ip_upgrade.log
summary.log
**/run_vivado/**/*.log
# Batch transcripts next to a sim/*.tcl directory (lab2/sim, lab1/lab4, later labN).
**/sim/*.log
runme.log
xsimcrash.log
xsimkernel.log
xvlog_*.log
xvhdl_*.log
# Implementation products, including copies that land outside *.runs/
*.dcp
*.bit
*.ltx
*.mmi
*.str
*.tmp
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.gen/
webtalk*/
usage_statistics_webtalk.*
hs_err_pid*
hs_err*
.crashReporter/
*.xpr.bak
*.backup
*.backup.*

# IP output Vivado writes beside a core. Keep .xci (the core itself), .coe and .mif.
**/xilinx_ip/**/sim/
**/xilinx_ip/**/simulation/
**/xilinx_ip/**/synth/
**/xilinx_ip/**/hdl/
**/xilinx_ip/**/misc/
**/xilinx_ip/**/doc/
**/xilinx_ip/**/*.v
**/xilinx_ip/**/*.vh
**/xilinx_ip/**/*.veo
**/xilinx_ip/**/*.vho
**/xilinx_ip/**/*.xml
**/xilinx_ip/**/*.xdc
# Project-managed IP directory: generated files go, the .xci stays.
*.srcs/**
!*.srcs/**/
!*.srcs/**/*.xci

# Local trace snapshots. golden_trace.txt itself stays.
golden_trace_lab*.txt

# Software link products, including lab1/lab4/func_lab4 and soft/func_lab4.
# Keep obj/*.coe and obj/*.mif (the images Vivado loads).
**/obj/*.elf
**/obj/*.bin
**/obj/*.data
*.o

# --- Sim dumps (xsim / waveforms). Keep *.wcfg; ignore lock files ---
xsim.dir/
*.wdb
*.wcfg.lock
xvlog.pb
xelab.pb
xvhdl.pb
*.vcd
*.saif
dfx_runtime.txt

# golden_trace.txt is required for myCPU vs reference compare — do not ignore it.
# Only drop obvious local copies/backups.
golden_trace.txt.bak
golden_trace.txt.old
*.bak
