*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.gen/
webtalk*/
usage_statistics_webtalk.*
hs_err_pid*
hs_err*
.crashReporter/
*.xpr.bak
*.backup
*.backup.*

